# ---------------------------------------------------------------------------
# Daily Drop API configuration. Copy to backend/.env and fill in.
# The server refuses to start in production if a required value is missing.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
# Number of reverse proxies in front of the app (Render/Railway/Fly: 1)
TRUST_PROXY=0

# MongoDB Atlas (must be a replica set — Atlas always is). Required in production.
MONGODB_URI=
# Local throwaway database instead of MONGODB_URI (development only)
USE_IN_MEMORY_DB=true

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed website origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Unpaid holds are released after this many hours (or at shift start, if sooner)
BOOKING_HOLD_HOURS=48
BOOKING_MAX_ADVANCE_DAYS=365
TERMS_VERSION=2026-11

# Public website address, used in emailed links (password reset, email confirmation)
APP_URL=http://localhost:5173

# --- Email (transactional) ---
# SMTP connection string from your email provider (Postmark, SendGrid, Amazon SES, Mailgun...).
# Without it, emails are sent through the Google Apps Script webhook (if configured).
SMTP_URL=
EMAIL_FROM=Daily Drop Kitchens <bookings@dailydrop.today>
# Block bookings until the customer confirms their email (needs SMTP_URL or the webhook)
REQUIRE_EMAIL_VERIFICATION=false

# --- Staff security ---
# Staff and directors must use an authenticator app code to sign in
REQUIRE_ADMIN_2FA=false
# Encrypts 2FA keys at rest (32+ chars). If unset, derived from JWT_SECRET.
ENCRYPTION_KEY=
# memory | mongo  (mongo shares rate limits across several API instances; default in production)
RATE_LIMIT_STORE=

# --- Seller details printed on tax invoices (SELLER_ABN required in production) ---
SELLER_LEGAL_NAME=Daily Drop Commercial Kitchens Pty Ltd
SELLER_TRADING_NAME=Daily Drop Commercial Kitchens
# Replace with the business's real ABN (checksum is validated at startup)
SELLER_ABN=
SELLER_ADDRESS=Unit 1, 1 Lichfield St, Victoria Park WA 6101
SELLER_EMAIL=hello@dailydrop.today
SELLER_PHONE=0479 175 705
INVOICE_DUE_DAYS=2

# --- Payment details shown to customers. Leave blank to hide them. ---
# Verify these against the actual bank account before going live.
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_NAME=
PAYMENT_BSB=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_PAYID=

# --- Google Sheets reporting webhook (optional) ---
# Deploy google-apps-script.js and set the same secret in its Script Properties.
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=

# --- Gemini finance assistant (optional, server-side only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

STORAGE_BAY_COUNT=2
