# Daily Drop Commercial Kitchen Platform Configuration

# Database
# For SQLite: sqlite:///./dailydrop_kitchen.db
# For PostgreSQL: postgresql://username:password@localhost:5432/dailydrop_kitchen
DATABASE_URL=sqlite:///./dailydrop_kitchen.db

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Daily Drop Kitchen Defaults
DEFAULT_HOURLY_RATE=45.0
DEFAULT_MIN_HOURS=2
DEFAULT_CLEANING_FEE=25.0
DEFAULT_SECURITY_DEPOSIT=150.0

# Contact & Notifications
KITCHEN_SUPPORT_EMAIL=kitchens@dailydrop.com.au
KITCHEN_SUPPORT_PHONE=+61 472 701 922
KITCHEN_WHATSAPP_NUMBER=+61472701922
